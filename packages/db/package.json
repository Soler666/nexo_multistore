{
  "name": "@repo/db",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "dotenv -e ../../.env -o -- prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "db:push": "dotenv -e ../../.env -o -- prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.11.0",
    "typescript": "^5.3.3"
  }
}
