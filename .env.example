# SQLite local (Prisma creates packages/db/dev.db on first db:push)
DATABASE_URL="file:../dev.db"

# Generate independent random secrets for both values (at least 32 bytes each)
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret"

# Platform administrator Google account (optional; exact verified email)
SUPER_ADMIN_EMAIL=""

# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Browser/API origins
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_PUBLIC_URL="http://localhost:4000"
PORT=4000
